{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentRouter",
  "version": "0.1.0",
  "identifier": "org.agentrouter.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8787"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentRouter",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
